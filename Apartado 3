def normalizar_puntos(puntos):
    puntos_homogeneos = np.hstack([puntos, np.ones((puntos.shape[0], 1))])
    media = np.mean(puntos_homogeneos, axis=0)
    desviacion = np.std(puntos_homogeneos)
    T = np.array([[1/desviacion, 0, -media[0]/desviacion],
                  [0, 1/desviacion, -media[1]/desviacion],
                  [0, 0, 1]])
    puntos_normalizados = (T @ puntos_homogeneos.T).T
    return puntos_normalizados, T

def obtener_puntos(x1, x2):
    A = []
    for i in range(len(x1)):
        x1i, y1i = x1[i][0], x1[i][1]
        x2i, y2i = x2[i][0], x2[i][1]
        A.append([x2i * x1i, x2i * y1i, x2i,
                  y2i * x1i, y2i * y1i, y2i,
                  x1i, y1i, 1])
    A = np.array(A)
    _, _, Vt = np.linalg.svd(A)
    F = Vt[-1].reshape(3, 3)
    U, S, Vt = np.linalg.svd(F)
    S[2] = 0  # Forzar rango 2
    F_rank2 = U @ np.diag(S) @ Vt
    return F_rank2

def ransac(x1, x2, umbral=1.0, max_iter=2000):
    mejor_F = None
    mejores_inliers = None
    max_inliers = 0

    for _ in range(max_iter):
        idx = np.random.choice(len(x1), 8, replace=False)
        x1_sub = x1[idx]
        x2_sub = x2[idx]

        x1_norm, T1 = normalizar_puntos(x1_sub)
        x2_norm, T2 = normalizar_puntos(x2_sub)

        F_norm = obtener_puntos(x1_norm, x2_norm)
        F = T2.T @ F_norm @ T1

        errores = []
        for i in range(len(x1)):
            x1h = np.append(x1[i], 1)
            x2h = np.append(x2[i], 1)
            error = abs(x2h.T @ F @ x1h)
            errores.append(error)
        errores = np.array(errores)

        inliers = errores < umbral
        num_inliers = np.sum(inliers)

        if num_inliers > max_inliers:
            max_inliers = num_inliers
            mejor_F = F
            mejores_inliers = inliers

    return mejor_F, mejores_inliers

def obtener_epipolos(F):
    _, _, Vt = np.linalg.svd(F)
    e_izq = Vt[-1]
    e_izq /= e_izq[-1]
    
    _, _, Vt_T = np.linalg.svd(F.T)
    e_der = Vt_T[-1]
    e_der /= e_der[-1]
    
    return e_izq[:2], e_der[:2]

def lineas_epipolares(imagen_izq, imagen_der, F, puntos_izq, puntos_der):
    img_izq = cv2.cvtColor(imagen_izq, cv2.COLOR_GRAY2BGR)
    img_der = cv2.cvtColor(imagen_der, cv2.COLOR_GRAY2BGR)

    lineas_izq = cv2.computeCorrespondEpilines(puntos_der.reshape(-1,1,2), 2, F).reshape(-1,3)
    lineas_der = cv2.computeCorrespondEpilines(puntos_izq.reshape(-1,1,2), 1, F).reshape(-1,3)

    for r, pt in zip(lineas_izq, puntos_izq):
        color = (0,255,255)
        x0, y0 = 0, int(-r[2]/r[1])
        x1, y1 = imagen_izq.shape[1], int(-(r[2]+r[0]*imagen_izq.shape[1])/r[1])
        cv2.line(img_izq, (x0,y0), (x1,y1), color,1)
        cv2.circle(img_izq, tuple(pt.astype(int)), 5, (0,0,255), -1)

    for r, pt in zip(lineas_der, puntos_der):
        color = (0,255,255)
        x0, y0 = 0, int(-r[2]/r[1])
        x1, y1 = imagen_der.shape[1], int(-(r[2]+r[0]*imagen_der.shape[1])/r[1])
        cv2.line(img_der, (x0,y0), (x1,y1), color,1)
        cv2.circle(img_der, tuple(pt.astype(int)), 5, (0,0,255), -1)

    e_izq, e_der = obtener_epipolos(F)
    cv2.circle(img_izq, tuple(e_izq.astype(int)), 10, (0,255,0), -1)
    cv2.circle(img_der, tuple(e_der.astype(int)), 10, (0,255,0), -1)

    plt.figure(figsize=(12,6))
    plt.subplot(121), plt.imshow(cv2.cvtColor(img_izq, cv2.COLOR_BGR2RGB)), plt.title("Imagen Izquierda")
    plt.subplot(122), plt.imshow(cv2.cvtColor(img_der, cv2.COLOR_BGR2RGB)), plt.title("Imagen Derecha")
    plt.show()

def matriz_fundamental(ruta_img1, ruta_img2):
    img1 = cv2.imread(ruta_img1, cv2.IMREAD_GRAYSCALE)
    img2 = cv2.imread(ruta_img2, cv2.IMREAD_GRAYSCALE)
    if img1 is None or img2 is None:
        print("Error cargando las imágenes.")
        return None, None, None

    sift = cv2.SIFT_create()
    kp1, des1 = sift.detectAndCompute(img1, None)
    kp2, des2 = sift.detectAndCompute(img2, None)

    bf = cv2.BFMatcher(cv2.NORM_L2, crossCheck=True)
    matches = bf.match(des1, des2)

    if len(matches) < 8:
        print("No hay suficientes matches.")
        return None, None, None

    pts_izq = np.array([kp1[m.queryIdx].pt for m in matches])
    pts_der = np.array([kp2[m.trainIdx].pt for m in matches])

    F, inliers = ransac(pts_izq, pts_der)
    if F is None:
        print("No se pudo calcular la matriz fundamental.")
        return None, None, None

    pts_izq_inliers = pts_izq[inliers]
    pts_der_inliers = pts_der[inliers]

    lineas_epipolares(img1, img2, F, pts_izq_inliers, pts_der_inliers)

    print("Matriz Fundamental F:")
    print(F)
    print("\nValores singulares de F:")
    print(np.linalg.svd(F)[1])
    print("\nError epipolar medio:")
    errores = [abs(np.append(p1,1).T @ F @ np.append(p2,1)) for p1,p2 in zip(pts_izq_inliers, pts_der_inliers)]
    print(np.mean(errores))
    print(f"\nNúmero de inliers: {len(pts_izq_inliers)} de {len(pts_izq)} matches totales")

    print("\nPuntos inliers en la imagen izquierda:")
    print(pts_izq_inliers)
    print("\nPuntos inliers en la imagen derecha:")
    print(pts_der_inliers)

    return F, pts_izq_inliers, pts_der_inliers


F, pts_izq_inliers, pts_der_inliers = matriz_fundamental('pelota2.jpg', 'pelota1.jpg')
