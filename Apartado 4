def matriz_esencial(F, mtx):
    """
    Calcula la matriz esencial E a partir de la matriz fundamental F y la matriz de calibración K.
    
    Parámetros:
    F (numpy.ndarray): Matriz fundamental 3x3.
    K (numpy.ndarray): Matriz intrínseca 3x3 de la cámara.
    
    Retorna:
    E (numpy.ndarray): Matriz esencial 3x3.
    """
    # Calcular la matriz esencial E
    E = np.dot(np.dot(mtx.T, F), mtx)
    
    # Imprimir la matriz esencial
    print("Matriz Esencial E:")
    print(E)
    
    return E

# Llamar a la función para calcular la matriz esencial utilizando las matrices F y K definidas previamente
E = matriz_esencial(F, mtx)
