def matriz_esencial(F, mtx):
    E = mtx.T @ F @ mtx
    
    U, S, Vt = np.linalg.svd(E)

    S_new = np.array([(S[0] + S[1]) / 2, (S[0] + S[1]) / 2, 0])
    print("Valores singulares para E:", S_new)

    E = U @ np.diag(S_new) @ Vt
    print("Matriz Esencial E:")
    print(E)

    return E

