def guardar_imagenes(imagenes, filas=7, columnas=7, tamaño_cuadro=0.25):
    """
    Verifica las imágenes y devuelve los puntos 3D y 2D.
    """
    objpoints = [] 
    imgpoints = []  

    objp = np.zeros((filas * columnas, 3), np.float32)  
    objp[:, :2] = np.mgrid[0:columnas, 0:filas].T.reshape(-1, 2)
    objp *= tamaño_cuadro 

    for fname in imagenes:
        if not os.path.exists(fname):
            continue 
        img = cv2.imread(fname) 
        if img is None:
            continue  
                
        gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY) 
                
        ret, corners = cv2.findChessboardCorners(
            gray, (columnas, filas),
            flags=cv2.CALIB_CB_ADAPTIVE_THRESH + cv2.CALIB_CB_NORMALIZE_IMAGE + cv2.CALIB_CB_FILTER_QUADS
        )
        
        if ret:
            criteria = (cv2.TERM_CRITERIA_EPS + cv2.TERM_CRITERIA_MAX_ITER, 30, 0.1)
            cv2.cornerSubPix(gray, corners, (11, 11), (-1, -1), criteria)
                
            objpoints.append(objp)
            imgpoints.append(corners)

    if len(objpoints) == 0 or len(imgpoints) == 0:
        return None, None

    return objpoints, imgpoints

def calibrar_matriz_P(imagenes, tamaño_cuadro=0.25, filas=7, columnas=7):
    """
    Calibra la cámara a partir de un conjunto de imágenes y devuelve detalles de la calibración.
    """
    objpoints, imgpoints = guardar_imagenes(imagenes, filas, columnas, tamaño_cuadro)

    if objpoints is None or imgpoints is None:
        print("No se pudieron obtener los puntos necesarios para la calibración.")
        return None

    img = cv2.imread(imagenes[0])
    image_size = img.shape[:2]

    ret, mtx, dist, rvecs, tvecs = cv2.calibrateCamera(objpoints, imgpoints, image_size[::-1], None, None)
    
    if not ret:
        print("La calibración falló. Asegúrate de que las imágenes son adecuadas.")
        return None
    
    return mtx, dist, rvecs, tvecs

