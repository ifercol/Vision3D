        z_min, z_max = 100, 1500
        if nube_puntos.size == 0:
            print("Ningún punto 3D generado.")
        else:
            filtro = (nube_puntos[:, 2] >= z_min) & (nube_puntos[:, 2] <= z_max)
            nube_filtrada = nube_puntos[filtro]
            colores_filtrados = colores[filtro]
            print(f"Puntos tras filtrado Z [{z_min}, {z_max}]: {len(nube_filtrada)}")

            if len(nube_filtrada) > 0:
