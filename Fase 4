def ajustar_K_por_recorte(K_original, x_offset, y_offset):
    K = K_original.copy()
    K[0, 2] -= x_offset
    K[1, 2] -= y_offset
    return K

def emparejamiento_por_bloques(imagen_izq, imagen_der, tamaño_bloque=7, disp_max=64):
    alto, ancho = imagen_izq.shape
    mitad = tamaño_bloque // 2
    disparidad = np.zeros((alto, ancho), dtype=np.float32)

    for y in range(mitad, alto - mitad):
        for x in range(mitad + disp_max, ancho - mitad):
            ssd_min = float('inf')
            mejor_desplazamiento = 0

            bloque_izq = imagen_izq[y - mitad:y + mitad + 1, x - mitad:x + mitad + 1]

            for d in range(disp_max):
                x_der = x - d
                if x_der - mitad < 0:
                    continue
                bloque_der = imagen_der[y - mitad:y + mitad + 1, x_der - mitad:x_der + mitad + 1]
                ssd = np.sum((bloque_izq - bloque_der) ** 2)

                if ssd < ssd_min:
                    ssd_min = ssd
                    mejor_desplazamiento = d

            disparidad[y, x] = mejor_desplazamiento

    return disparidad

def disparidad_a_nube_3d_con_color(disparidad, imagen_color, K, baseline=1.0):
    alto, ancho = disparidad.shape
    f = K[0, 0]
    cx = K[0, 2]
    cy = K[1, 2]

    puntos_3d = []
    colores = []

    for y in range(alto):
        for x in range(ancho):
            d = disparidad[y, x]
            if d <= 0:
                continue
            Z = (f * baseline) / d
            X = (x - cx) * Z / f
            Y = (y - cy) * Z / f
            r, g, b = imagen_color[y, x]
            puntos_3d.append([X, Y, Z])
            colores.append([r / 255.0, g / 255.0, b / 255.0])

    return np.array(puntos_3d), np.array(colores)

def mostrar_nube_3d_coloreada(puntos_xyz, colores_rgb, nombre_imagen='nube_3d_coloreada.png'):
    fig = plt.figure(figsize=(10, 7))
    ax = fig.add_subplot(111, projection='3d')

    muestra_xyz = puntos_xyz[::5]
    muestra_colores = colores_rgb[::5]
    ax.scatter(muestra_xyz[:, 0], muestra_xyz[:, 1], muestra_xyz[:, 2], s=3, c=muestra_colores)

    ax.set_title("Nube de puntos 3D con color real")
    ax.set_xlabel("X")
    ax.set_ylabel("Y")
    ax.set_zlabel("Z")
    plt.savefig(nombre_imagen, dpi=300, bbox_inches='tight')
    plt.show()

