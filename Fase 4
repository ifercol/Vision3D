import numpy as np
import matplotlib.pyplot as plt
import cv2

def emparejamiento_por_bloques(Il, Ir, tamaño_bloque=5, disparidad_max=64):
    h, w = Il.shape
    mitad = tamaño_bloque // 2
    disparidad = np.zeros((h, w), dtype=np.float32)

    # Padding de las imágenes para evitar errores al acceder a los bordes
    Il_pad = np.pad(Il, ((mitad, mitad), (mitad, mitad)), mode='constant', constant_values=0)
    Ir_pad = np.pad(Ir, ((mitad, mitad), (mitad, mitad)), mode='constant', constant_values=0)

    # Calcular el mapa de disparidad por bloque
    for y in range(mitad, h - mitad):
        for x in range(mitad + disparidad_max, w - mitad):
            bloque_izq = Il_pad[y:y + tamaño_bloque, x:x + tamaño_bloque]
            ssd_min = float('inf')
            mejor_desplazamiento = 0

            for d in range(disparidad_max):
                xr = x - d
                if xr - mitad < 0:
                    continue
                bloque_der = Ir_pad[y:y + tamaño_bloque, xr:xr + tamaño_bloque]
                ssd = np.sum((bloque_izq - bloque_der) ** 2)
                if ssd < ssd_min:
                    ssd_min = ssd
                    mejor_desplazamiento = d

            disparidad[y, x] = mejor_desplazamiento
    return disparidad

def reproyectar_a_3D(disparidad, Q):
    h, w = disparidad.shape
    puntos_3D = np.zeros((h, w, 3), dtype=np.float32)

    for y in range(h):
        for x in range(w):
            d = disparidad[y, x]
            if d == 0:
                continue
            vec = np.array([x, y, d, 1.0], dtype=np.float32)
            X = Q @ vec
            X /= X[3]
            puntos_3D[y, x] = X[:3]
    return puntos_3D

def visualizar_nube(puntos_3D, imagen, disparidad):
    mascara = disparidad > 0
    xyz = puntos_3D[mascara]
    colores = imagen[mascara] / 255.0

    fig = plt.figure(figsize=(10, 8))
    ax = fig.add_subplot(111, projection='3d')
    idx = np.random.choice(xyz.shape[0], size=min(10000, xyz.shape[0]), replace=False)
    ax.scatter(xyz[idx, 0], xyz[idx, 1], xyz[idx, 2], c=colores[idx], s=0.5)
    ax.set_title("Nube de puntos 3D")
    plt.show()

# --- Cargar imágenes ---
Il = cv2.imread("left.png", cv2.IMREAD_GRAYSCALE)
Ir = cv2.imread("right.png", cv2.IMREAD_GRAYSCALE)

# Verificar si las imágenes se han cargado correctamente
if Il is None or Ir is None:
    raise FileNotFoundError("No se pudo cargar una o ambas imágenes.")

# Mostrar las imágenes para verificar que están bien cargadas
plt.subplot(1, 2, 1)
plt.imshow(Il, cmap='gray')
plt.title("Imagen izquierda")

plt.subplot(1, 2, 2)
plt.imshow(Ir, cmap='gray')
plt.title("Imagen derecha")
plt.show()

# Redimensionar las imágenes a las mismas dimensiones si es necesario
if Il.shape != Ir.shape:
    Ir = cv2.resize(Ir, (Il.shape[1], Il.shape[0]))

# Verificar dimensiones después de redimensionar
print(f"Dimensiones imagen izquierda: {Il.shape}")
print(f"Dimensiones imagen derecha: {Ir.shape}")

# --- Calcular disparidad ---
disp = emparejamiento_por_bloques(Il, Ir, tamaño_bloque=5, disparidad_max=64)

# Visualizar el mapa de disparidad
plt.imshow(disp, cmap='plasma')
plt.title("Mapa de disparidad")
plt.colorbar()
plt.show()

# --- Matriz Q sintética ---
focal = 1.0
baseline = 1.0
cx = Il.shape[1] / 2
cy = Il.shape[0] / 2

Q = np.array([
    [1, 0, 0, -cx],
    [0, -1, 0, cy],  # se invierte Y para que apunte hacia arriba
    [0, 0, 0, -focal],
    [0, 0, 1 / baseline, 0]
], dtype=np.float32)

# --- Generar nube de puntos ---
puntos_3D = reproyectar_a_3D(disp, Q)

# Verificar el tamaño de la nube de puntos
print(f"Puntos 3D generados: {puntos_3D.shape}")

# Verificar si hay algún valor vacío o nulo en los puntos 3D
print(f"Valores nulos en la nube de puntos: {np.any(np.isnan(puntos_3D))}")

# --- Visualizar la nube de puntos 3D ---
visualizar_nube(puntos_3D, Il, disp)
