    K = ajustar_K_por_recorte(K_original, x0, y0)

    print("Calculando disparidad...")
    mapa_disparidad = emparejamiento_por_bloques(img_izq, img_der, tamaño_bloque=7, disp_max=64)

    num_validos = np.count_nonzero(mapa_disparidad)
    print("Píxeles con disparidad válida:", num_validos)
    if num_validos == 0:
        print("No se encontró ninguna disparidad válida. Verificá el recorte y el rango disp_max.")
    else:
        print("Rango de disparidades:", np.min(mapa_disparidad), np.max(mapa_disparidad))

        plt.imshow(mapa_disparidad, cmap='plasma')
